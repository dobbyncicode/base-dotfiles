#!/usr/bin/env python3

from urllib.parse import unquote
import requests
import argparse
import sys
from tqdm import tqdm
import os
import re
import threading
import math
import shutil

thread_errors = []

# --- [ i ] - TTY Colors ---
class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    RED = "\033[91m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    BLUE = "\033[94m"
    CYAN = "\033[96m"
    WHITE = "\033[97m"
    GREY = "\033[90m"

def fmt_size(size_bytes):
    if size_bytes == 0: return "0 B"
    size_name = ("B", "KB", "MB", "GB", "TB")
    i = int(math.floor(math.log(size_bytes, 1024)))
    p = math.pow(1024, i)
    s = round(size_bytes / p, 2)
    return f"{s} {size_name[i]}"

def out(tag_type, msg, color=None):
    tags = {
        "!": f"{Colors.RED}[ {Colors.BOLD}!{Colors.RESET}{Colors.RED} ]{Colors.RESET}",
        "i": f"{Colors.CYAN}[ i ]{Colors.RESET}",
        "~": f"{Colors.YELLOW}[ ~ ]{Colors.RESET}",
        "x": f"{Colors.RED}[ x ]{Colors.RESET}",
        "?": f"{Colors.YELLOW}[ ? ]{Colors.RESET}",
        ">": f"{Colors.GREEN}[ > ]{Colors.RESET}",
        "o": f"{Colors.GREEN}[ o ]{Colors.RESET}",
    }
    prefix = tags.get(tag_type, "")
    if color:
        print(f"{prefix} {color}{msg}{Colors.RESET}")
    else:
        print(f"{prefix} {msg}")

def ask(tag_type, prompt, default=None, color=None):
    tags = {
        "!": f"{Colors.RED}[ {Colors.BOLD}!{Colors.RESET}{Colors.RED} ]{Colors.RESET}",
        "i": f"{Colors.CYAN}[ i ]{Colors.RESET}",
        "~": f"{Colors.YELLOW}[ ~ ]{Colors.RESET}",
        "x": f"{Colors.RED}[ x ]{Colors.RESET}",
        "?": f"{Colors.YELLOW}[ ? ]{Colors.RESET}",
        ">": f"{Colors.GREEN}[ > ]{Colors.RESET}",
        "o": f"{Colors.GREEN}[ o ]{Colors.RESET}",
    }
    prefix = tags.get(tag_type, "")
    suffix = f" [{default}] " if default else " "
    full_prompt = f"{prefix} {color or ''}{prompt}{suffix}{Colors.RESET}"
    return input(full_prompt).strip()

def extract_drive_id(input_str: str) -> str:
    pattern = r'/file/d/([a-zA-Z0-9_-]+)'
    match = re.search(pattern, input_str)
    if match:
        return match.group(1)
    return input_str

def get_video_url(page_content: str, verbose: bool) -> tuple[str, str]:
    if verbose:
        out("i", "Parsing video playback URL and title.")
    contentList = page_content.split("&")
    video, title = None, None
    for content in contentList:
        if content.startswith('title=') and not title:
            title = unquote(content.split('=')[-1])
        elif "videoplayback" in content and not video:
            video = unquote(content).split("|")[-1]
        if video and title:
            break

    if verbose:
        out("i", f"Video URL: {video}")
        out("i", f"Video Title: {title}")

    return video, title

def get_file_size(url: str, cookies: dict) -> int:
    response = requests.head(url, cookies=cookies, allow_redirects=True)
    size = int(response.headers.get('content-length', 0))
    return size

def handle_file_exists(filename: str, new_size: int) -> str:
    existing_size = os.path.getsize(filename)
    out("!", f"{Colors.WHITE}{os.path.basename(filename)}{Colors.RESET} already exists in {Colors.YELLOW}{os.path.dirname(filename) or '.'}{Colors.RESET}.")
    out("i", f"Current: {fmt_size(existing_size)}")
    out("i", f"New:     {fmt_size(new_size)}")
    
    choice = ask(">", "[S]kip, [O]verwrite, or [C]reate new?", "c", Colors.GREEN).lower()
    
    if choice.startswith('s'):
        return 'skip'
    elif choice.startswith('o'):
        return 'overwrite'
    else:
        return 'create_new'

def resolve_output_path(title: str, custom_output: str, new_size: int = 0) -> str:
    if custom_output:
        parent = os.path.dirname(custom_output)
        if parent:
            os.makedirs(parent, exist_ok=True)
        if not os.path.splitext(custom_output)[1]:
            custom_output += ".mp4"
        path = custom_output
    else:
        safe_title = sanitize_filename(title)
        if not os.path.splitext(safe_title)[1]:
            safe_title += ".mp4"
        path = safe_title

    if os.path.exists(path) and new_size > 0:
        action = handle_file_exists(path, new_size)
        if action == 'skip':
            return None
        elif action == 'create_new':
            base, ext = os.path.splitext(path)
            i = 1
            while os.path.exists(f"{base}-{i}{ext}"):
                i += 1
            path = f"{base}-{i}{ext}"
        elif action == 'overwrite':
            os.remove(path)
            
    return path

def download_part(url: str, cookies: dict, thread_lock, start: int, end: int, part_num: int, part_filename: str, chunk_size: int, pbar: tqdm, gpbar: tqdm, verbose: bool) -> None:
    headers = {'Range': f'bytes={start}-{end}'}

    downloaded = 0
    if os.path.exists(part_filename):
        downloaded = os.path.getsize(part_filename)
        if downloaded > 0:
            headers['Range'] = f'bytes={start + downloaded}-{end}'
            with thread_lock:
                gpbar.update(downloaded)
                pbar.update(downloaded)
            
            if verbose:
                out("i", f"Resuming part {part_filename} from byte {start + downloaded}")

    if downloaded >= (end - start + 1):
        return
        
    s = requests.Session()
    try:
        response = s.get(url, stream=True, cookies=cookies, headers=headers)
        if response.status_code not in (200, 206):
            raise Exception(f"Failed to download part {part_filename}, status: {response.status_code}")
        
        file_mode = 'ab' if os.path.exists(part_filename) and os.path.getsize(part_filename) > 0 else 'wb'
        with open(part_filename, file_mode) as f:
            for chunk in response.iter_content(chunk_size=chunk_size):
                f.write(chunk)
                with thread_lock:
                    gpbar.update(len(chunk))
                    pbar.update(len(chunk))
                downloaded += len(chunk)
                if downloaded >= (end - start + 1):
                    break
    finally:
        s.close()

def download_part_wrapper(*args):
    try:
        download_part(*args)
    except Exception as e:
        thread_errors.append(e)

def merge_parts(part_files: list[str], output_filename: str, verbose: bool) -> None:
    if verbose:
        out("i", f"Merging {len(part_files)} parts into {output_filename}")

    missing = [pf for pf in part_files if not os.path.exists(pf)]
    if missing:
        out("x", f"Missing parts: {missing}")
        return

    with open(output_filename, 'wb') as outfile:
        for part_file in part_files:
            if verbose:
                out("~", f"Merging {part_file}")
            with open(part_file, 'rb') as pf:
                shutil.copyfileobj(pf, outfile)
    
    for part_file in part_files:
        os.remove(part_file)

    if verbose:
        out("o", "Merge complete. Cleaned up part files.")

def download_file(url: str, cookies: dict, filename: str, chunk_size: int, num_threads: int, verbose: bool) -> None:
    thread_errors.clear()

    total_size = get_file_size(url, cookies)
    if num_threads == 1:
        download_single_threaded(url, cookies, filename, chunk_size, verbose)
        return
    if total_size == 0:
        out("~", "Could not determine file size. Falling back to single-threaded download.")
        download_single_threaded(url, cookies, filename, chunk_size, verbose)
        return

    if verbose:
        out("i", f"Total file size: {fmt_size(total_size)}")
        out("i", f"Downloading with {num_threads} threads")

    part_size = math.ceil(total_size / num_threads)
    part_files = []
    threads = []

    gpbar = tqdm(
        unit='B', unit_scale=True,
        desc=f"{Colors.CYAN}progress{Colors.RESET}",
        total=total_size,
        position=0,
        bar_format='{l_bar}{bar}| {n_fmt}/{total_fmt} [{elapsed}<{remaining}]'
    )

    pbars = []
    if verbose:
        pbars = [
            tqdm(
                unit='B', unit_scale=True,
                desc=f"  part {i+1}",
                total=min((i * part_size) + part_size - 1, total_size - 1) - (i * part_size) + 1,
                position=i+1
            )
            for i in range(num_threads)
        ]
    else:
        pbars = [tqdm(total=0, disable=True) for _ in range(num_threads)]

    thread_lock = threading.Lock()

    for i in range(num_threads):
        start = i * part_size
        end = min(start + part_size - 1, total_size - 1)
        part_filename = f"{filename}.part{i}"
        part_files.append(part_filename)

        t = threading.Thread(
            target=download_part_wrapper,
            args=(url, cookies, thread_lock, start, end, i, part_filename, chunk_size, pbars[i], gpbar, verbose),
            daemon=True
        )
        threads.append(t)
        t.start()

    for t in threads:
        t.join()

    gpbar.close()
    for pbar in pbars:
        pbar.close()
    
    if len(thread_errors) > 0:
        out("x", f"One of the parts failed. Check the console for details.")
        return

    missing_parts = [pf for pf in part_files if not os.path.exists(pf)]
    if missing_parts:
        out("x", f"Missing part files: {missing_parts}")
        return

    downloaded_total = sum(os.path.getsize(pf) for pf in part_files)
    if downloaded_total < total_size:
        out("x", f"Download incomplete: got {fmt_size(downloaded_total)}/{fmt_size(total_size)}")
        return

    merge_parts(part_files, filename, verbose)
    out("o", f"Saved to {Colors.YELLOW}{filename}{Colors.RESET}")
    out("o", "Done")

def download_single_threaded(url: str, cookies: dict, filename: str, chunk_size: int, verbose: bool) -> None:
    headers = {}
    file_mode = 'wb'
    downloaded_size = 0

    if os.path.exists(filename):
        downloaded_size = os.path.getsize(filename)
        headers['Range'] = f"bytes={downloaded_size}-"
        file_mode = 'ab'

    if verbose:
        out("i", f"Starting single-threaded download from {url}")

    response = requests.get(url, stream=True, cookies=cookies, headers=headers)
    if response.status_code in (200, 206):
        total_size = int(response.headers.get('content-length', 0)) + downloaded_size
        with open(filename, file_mode) as file:
            with tqdm(
                total=total_size, 
                initial=downloaded_size, 
                unit='B', 
                unit_scale=True, 
                desc=f"{Colors.CYAN}progress{Colors.RESET}", 
                file=sys.stdout,
                bar_format='{l_bar}{bar}| {n_fmt}/{total_fmt} [{elapsed}<{remaining}]'
            ) as pbar:
                for chunk in response.iter_content(chunk_size=chunk_size):
                    if chunk:
                        file.write(chunk)
                        pbar.update(len(chunk))
        out("o", f"Saved to {Colors.YELLOW}{filename}{Colors.RESET}")
        out("o", "Done")
    else:
        out("x", f"Error downloading {Colors.RED}{filename}{Colors.RESET}, status code: {response.status_code}")

def sanitize_filename(name: str) -> str:
    valid = re.sub(r'[<>:"/\\|?*\x00-\x1F]', '', name)
    valid = re.sub(r'[. ]+$', '', valid)
    return valid or "untitled_video"

def validate_source(source: str) -> bool:
    if not source:
        return False
    if ' ' in source and not (source.startswith('http') or source.startswith('/file/')):
        return False
    return True

def main(video_id_or_url: str, output_file: str = None, num_threads: int = 4, verbose: bool = False) -> None:
    if not validate_source(video_id_or_url):
        out("x", "Invalid source. Wrap the url in quotes.")
        sys.exit(1)

    video_id = extract_drive_id(video_id_or_url)
    
    if verbose:
        out("i", f"Extracted video ID: {video_id}")
    
    drive_url = f'https://drive.google.com/u/0/get_video_info?docid={video_id}&drive_originator_app=303'
    
    if verbose:
        out("i", f"Accessing {drive_url}")

    try:
        response = requests.get(drive_url)
        response.raise_for_status()
    except requests.RequestException as e:
        out("x", f"Failed to fetch video info: {e}")
        return

    page_content = response.text
    cookies = response.cookies.get_dict()

    video, title = get_video_url(page_content, verbose)

    if not video:
        out("x", "Unable to retrieve the video URL. Ensure the video ID is correct and accessible.")
        return

    # Get size first to handle file conflicts before downloading
    temp_size = get_file_size(video, cookies)
    filename = resolve_output_path(title, output_file, temp_size)
    
    if filename is None:
        out("i", "Skipped download.")
        return

    if not verbose:
        print()
        out("~", f"Downloading: {Colors.WHITE}{os.path.basename(filename)}{Colors.RESET}")
        out("i", f"Size: {fmt_size(temp_size)}")
        print("-" * 40)
    
    download_file(video, cookies, filename, 1024, num_threads, verbose)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        prog='gdl',
        description="download videos from google drive",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
usage:
  gdl "https://drive.google.com/file/d/ID/view"
  gdl "https://drive.google.com/file/d/ID/view" -o /path/to/output.mp4
  gdl "https://drive.google.com/file/d/ID/view" -o ./videos/custom.mp4 -t 8 -v

flags:
  -o, --output    custom output path (auto-creates missing directories)
  -t, --threads   parallel threads 1-16 (default: 4)
  -v, --verbose   show detailed status messages
        """
    )
    parser.add_argument("source", type=str, help="google drive file id or full url (wrap in quotes)")
    parser.add_argument("-o", "--output", type=str, help="custom output path")
    parser.add_argument("-t", "--threads", type=int, default=4, choices=range(1, 17), help="threads 1-16 (default: 4)")
    parser.add_argument("-v", "--verbose", action="store_true", help="show detailed status")

    args = parser.parse_args()
    main(args.source, args.output, args.threads, args.verbose)

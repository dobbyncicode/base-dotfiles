# --- [ i ] - Ghostty Config ---

# --- Padding ---

# Horizontal padding between terminal cells and the left/right borders.
window-padding-x = 24

# Vertical padding between terminal cells and the top/bottom borders.
window-padding-y = 16

# Balance the leftover pixels from the grid across all four edges instead of
# letting the top-left cell hug the border. This is what removes the "content
# is glued to the edge" look.
window-padding-balance = true

# --- Appearance ---

# Fill the padding area with the background colour so the border reads as
# empty space rather than a different shade.
window-padding-color = background
